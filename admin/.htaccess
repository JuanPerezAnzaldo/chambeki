# Rutas limpias del panel: /admin/login  ->  admin/index.php?ruta=login
# (en Hostinger/Apache funciona tal cual; en el servidor interno de Replit
#  este archivo se ignora: usa /admin/index.php?ruta=login)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # nunca se sirven directo los includes ni las pantallas
    RewriteRule ^(includes|pages)/ - [F,L]

    # todo lo que no sea un archivo real (css, js, img) va al router
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ index.php?ruta=$1 [QSA,L]
</IfModule>
